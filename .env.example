# Copy this file to .env and fill in whichever keys you need, then
# `export $(grep -v '^#' .env | xargs)` (or use direnv/python-dotenv)
# before running chat.py. .env is gitignored -- never commit real keys.

# Required: generation backend. Set ONE of the three options below.
# Checked in this order: OPENAI_API_KEY, then ANTHROPIC_API_KEY, then
# MODEL_SERVER_URL.

# Option 1 — OpenAI (gpt-4o-mini)
OPENAI_API_KEY=

# Option 2 — Anthropic (claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Option 3 — free, no API key: Ollama running on a Colab GPU, exposed
# through a Cloudflare tunnel. See:
# https://github.com/furkandrms/cloudflare-ollama-bridge
# Run that repo's notebook, paste the printed tunnel URL here.
MODEL_SERVER_URL=
MODEL_NAME=qwen3:8b

# Optional: routes rag-guard's own relevance/sufficiency/grounding checks
# through Jev instead of whichever backend above is generating.
TYPESAFE_API_KEY=
